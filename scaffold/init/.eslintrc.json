{
  "env": {
    "commonjs": true,
    "es6": true,
    "node": true{{#mocha}},
    "mocha": true{{/mocha}}
  },
  "extends": "airbnb-base",
  "globals": {
    "Atomics": "readonly",
    "SharedArrayBuffer": "readonly"
  },
  "parserOptions": {
    "ecmaVersion": 2022
  },
{{#vitest}}
  "overrides": [
    {
      "files": ["test/**/*.js", "vitest.config.mjs"],
      "parserOptions": {
        "sourceType": "module"
      },
      "rules": {
        "import/no-unresolved": ["error", { "ignore": ["^vitest/", "^dotenv/"] }]
      }
    }
  ],
{{/vitest}}
  "rules": {
    "func-names": "off",
    "import/no-unresolved": ["error", { "ignore": ["^dotenv/"] }],
    "no-await-in-loop": "off",
    "no-console": "off",
    "no-param-reassign": "off",
    "no-restricted-syntax": "off",
    "prefer-arrow-callback": "off"
  }
}
